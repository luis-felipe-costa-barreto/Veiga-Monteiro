---
const buttons = [
    {name:"Institucional", link:"./", icon:"fa-solid fa-building-columns"},
    {name:"Áreas de atuação", link:"./practiceAreas", icon:"fa-solid fa-gavel"},
    {name:"Fale conosco", link:"./contactUs", icon:"fa-solid fa-envelope"}
]
---
<aside class="-translate-x-full ease-in-out transition-transform fixed top-0 left-0 h-screen z-20 w-9/50 bg-background">
    <h1 class="text-3xl border-b font-bold flex h-30 text-center items-center">Veiga & Monteiro</h1>
    <div class="flex flex-col gap-4 m-2!">
        {
            buttons.map(b => {
                return <a class="rounded-md flex items-center gap-5 transition-colors p-2! hover:bg-gray-300 font-semibold"
                href={b.link}><i class={b.icon}></i>{b.name}</a>
            })
        }
    </div>
</aside>