---
const buttons = [
    {name:"Institucional", link:"/", icon:"corporate_fare"},
    {name:"Áreas de atuação", link:"/practiceAreas", icon:"gavel"},
    {name:"Fale conosco", link:"/contactUs", icon:"mail"}
]

const currentPath = Astro.url.pathname
---

<!--dark:bg-surface-container-highest -->
<!--dark:text-primary-fixed -->
<!--dark:border-outline -->
<aside class="bg-surface-container-low  text-primary  font-title-lg text-title-lg h-full w-80 rounded-r-none border-r border-outline-variant  shadow-xl fixed inset-y-0 left-0 z-60 flex flex-col transform transition-transform duration-300 ease-in-out -translate-x-full">
    
    <!--dark:border-outline -->
    <div class="px-6! py-8! border-b border-outline-variant  mb-4">
        <!--dark:text-primary-fixed -->
        <h1 class="font-display-lg-mobile! text-display-lg-mobile! text-primary ">VEIGA &amp; MONTEIRO</h1>
    </div>
    <div class="flex flex-col gap-3 m-2!">
        {
            buttons.map(b => {
                const isActive = currentPath.replace(/\/$/, '') === b.link.replace(/\/$/, '')
                return <a class={`flex items-center gap-4 px-4! py-3! m-2! duration-200 rounded-full transition-colors ${isActive ? "text-background bg-secondary" : "text-on-surface-variant hover:bg-surface-container" }`}
                href={b.link}>
                    <span class="material-symbols-outlined cursor-pointer" data-icon={b.icon}>{b.icon}</span>
                    {b.name}
                    </a>
            })
        }
    </div>
</aside>