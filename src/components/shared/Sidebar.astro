---
const buttons = [
    {name:"Institucional", link:"./", icon:"fa-solid fa-building-columns"},
    {name:"Áreas de atuação", link:"./practiceAreas", icon:"fa-solid fa-gavel"},
    {name:"Fale conosco", link:"./contactUs", icon:"fa-solid fa-envelope"}
]
---

<!--dark:bg-surface-container-highest -->
<!--dark:text-primary-fixed -->
<!--dark:border-outline -->
<aside class="bg-surface-container-low  text-primary  font-title-lg text-title-lg h-full w-80 rounded-r-none border-r border-outline-variant  shadow-xl fixed inset-y-0 left-0 z-60 flex flex-col transform transition-transform duration-300 ease-in-out">
    
    <!--dark:border-outline -->
    <div class="px-6! py-8! border-b border-outline-variant  mb-4">
        <!--dark:text-primary-fixed -->
        <h1 class="font-display-lg-mobile! text-display-lg-mobile! text-primary ">VEIGA &amp; MONTEIRO</h1>
    </div>
    <div class="flex flex-col gap-4 m-2!">
        {
            buttons.map(b => {
                return <a class="rounded-md flex items-center gap-5 transition-colors p-2! hover:bg-gray-300 font-semibold"
                href={b.link}>
                    <span class="material-symbols-outlined cursor-pointer" data-icon=""></span>
                    {b.name}
                    </a>
            })
        }
    </div>
</aside>